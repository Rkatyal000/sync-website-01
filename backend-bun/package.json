{
  "name": "backend-bun",
  "version": "1.0.0",
  "description": "Production-grade Bun + TypeScript backend mirroring the FastAPI implementation. Designed for low-memory, fast-cold-start deployments (Fly.io, Railway, Render, Docker/K8s).",
  "type": "module",
  "scripts": {
    "dev": "bun --hot run src/server.ts",
    "start": "bun run src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "test": "bun test"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "mongodb": "^6.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.1.13",
    "bun-types": "^1.3.14",
    "typescript": "5.6.3"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
